<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стили для кнопок -->
    <style name="WaveButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">140dp</item>
        <item name="android:minHeight">140dp</item>
        <item name="cornerRadius">70dp</item>
        <item name="elevation">12dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">120dp</item>
        <item name="android:minHeight">120dp</item>
        <item name="cornerRadius">60dp</item>
        <item name="elevation">8dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@android:color/transparent</item>
    </style>

    <!-- Стили для текста -->
    <style name="TextAppearanceTitle">
        <item name="android:textSize">@dimen/text_size_xlarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearanceSubtitle">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="TextAppearanceBody">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearanceCaption">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Стили для карточек - УПРОЩЕННАЯ ВЕРСИЯ -->
    <style name="CardViewStyle">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Стиль для результата - УПРОЩЕННАЯ ВЕРСИЯ -->
    <style name="ResultCardStyle" parent="CardViewStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">16dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>