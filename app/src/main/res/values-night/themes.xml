<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme -->
    <style name="Theme.VoiceDictation" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/on_surface</item>       <!-- БЕЛЫЙ -->
        <item name="android:textColorSecondary">@color/on_surface_variant</item>  <!-- СЕРЫЙ -->

        <!-- Error color -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.AppCompat.Button</item>

        <!-- EditText style -->
        <item name="editTextStyle">@style/Widget.AppCompat.EditText</item>

        <!-- Кастомные атрибуты для темной темы -->
        <!-- В темной теме все тексты БЕЛЫЕ -->
        <item name="editTextColorDark">@color/white</item>            <!-- БЕЛЫЙ -->
        <item name="checkTextTitleColorDark">@color/white</item>      <!-- БЕЛЫЙ -->
        <item name="buttonIconColorDark">@color/white</item>          <!-- БЕЛЫЙ -->

        <!-- Переопределение цвета текста в EditText -->
        <item name="android:editTextColor">?attr/editTextColorDark</item>
    </style>
</resources>