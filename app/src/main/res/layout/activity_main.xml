<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- EditText с авторасширением через фокус -->
    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/text_field_background_light"
        android:hint="Текст появится здесь..."
        android:gravity="top|start"
        android:minHeight="200dp"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="1000"
        android:scrollbars="vertical"
        android:padding="16dp"
        android:textSize="16sp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:focusableInTouchMode="true"
        android:isScrollContainer="true"
        android:focusedByDefault="false"/>

    <!-- Счетчик символов -->
    <TextView
        android:id="@+id/charCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Символов: 0 | Слов: 0"
        android:textSize="12sp"
        android:gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/on_surface_variant"/>

    <!-- Основная панель кнопок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Кнопка микрофона -->
        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_mic_white"
            android:background="@drawable/round_button_primary"
            android:contentDescription="Запись голоса"
            android:scaleType="center"
            android:elevation="4dp"
            app:tint="@color/white"/>

        <!-- Кнопка очистки -->
        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_clear"
            android:background="@drawable/round_button_secondary"
            android:contentDescription="Очистить текст"
            android:scaleType="center"
            android:elevation="2dp"
            app:tint="@color/on_surface"/>

        <!-- Кнопка копирования -->
        <ImageButton
            android:id="@+id/copyButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_content_copy"
            android:background="@drawable/round_button_secondary"
            android:contentDescription="Копировать текст"
            android:scaleType="center"
            android:elevation="2dp"
            app:tint="@color/on_surface"/>

        <!-- Кнопка поделиться -->
        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_share"
            android:background="@drawable/round_button_secondary"
            android:contentDescription="Поделиться текстом"
            android:scaleType="center"
            android:elevation="2dp"
            app:tint="@color/on_surface"/>

    </LinearLayout>

    <!-- Панель проверки текста -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center">

        <!-- Кнопка базовой проверки -->
        <Button
            android:id="@+id/btn_check_basic"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Базовая проверка"
            android:textAllCaps="false"
            android:backgroundTint="@color/purple_500"
            android:textColor="@color/white"
            android:enabled="false"
            style="@style/Widget.AppCompat.Button"
            android:elevation="2dp"/>

        <!-- Кнопка премиум проверки -->
        <Button
            android:id="@+id/btn_check_premium"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Премиум проверка"
            android:textAllCaps="false"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white"
            android:enabled="false"
            style="@style/Widget.AppCompat.Button"
            android:elevation="2dp"/>

    </LinearLayout>

    <!-- Индикатор анимации голоса -->
    <ImageView
        android:id="@+id/voiceAnimationView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_mic_24"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:contentDescription="Анимация записи"
        app:tint="@color/red_500"/>

</LinearLayout>